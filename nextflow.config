/*
 * =============================================================================
 * Negative steering, execution profile
 * =============================================================================
 * Resources come from the two labels the stages carry, 'gpu' and 'cpu'.
 *
 * Sized from the 146 measured benchmark runs in
 * analysis/03-compute-cost/, not from the old hand-written SLURM header.
 * That header asked 12 GB and 48 h to cover a whole run in one job:
 *
 *   peak RSS over 146 runs   3.6 GB min, 5.1 GB median, 5.1 GB max
 *   seconds per prediction   15.0 min, 20.6 median, 28.7 max
 *
 * One PREDICT_ONE task is one design, so num_seeds x diffusion_samples
 * predictions. At the benchmark's 3 x 5 and the worst observed rate that is
 * about 7 minutes, against the 6 h the task used to be allowed.
 *
 * Walltime is the figure worth cutting. The GPU is what makes a task scarce,
 * so memory over-asking costs little, but a 6 h request backfills far worse
 * than a 2 h one. 2 h is 16x the worst task observed, which leaves room for a
 * complex larger than any in the benchmark.
 */

manifest {
    name            = 'structure-negative-steering'
    description     = 'Boltz-2 negative steering over solved reference complexes'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

// The engine writes into experiments/.../run/, so Nextflow's own work tree only
// ever holds task scripts and logs. Keep it out of the repo root.
workDir = "${System.getenv('NXF_WORK') ?: 'work'}"

// The engine is invoked by absolute path, and the module needs this at include
// time, so it is set here rather than in main.nf.
// Every param is declared HERE, not with `params.x = ...` in main.nf.
//
// On Nextflow 25.10.4 a params assignment in the main script's body is not
// visible to an included module. `params.repo_root` resolved because it was
// declared here; `params.max_passing` did not, and rendered into the harvest
// command as the literal string "null", which argparse rejected after the run
// had already spent 45 GPU-minutes. The log warns "Access to undefined
// parameter" for each one, which is the signal to watch for.
params {
    // The engine is invoked by absolute path, and the module needs this at
    // include time.
    repo_root = projectDir.toString()

    // One config.yml, or a glob matching several. No default on purpose.
    targets = null

    // Cycle follow-up. max_cycles is fixed at 0 in the harvest stage: this
    // workflow is single-cycle by construction, and re-enabling follow-up
    // cycles means adding them to main.nf as channels, not letting Python call
    // sbatch again.
    max_passing    = 5
    novelty_cutoff = 10.0

    postprocess_populate_all = false

    // Only a fallback. Each config carries its own boltz_container.
    boltz_container = null

    // Every stage runs its Python inside the Boltz image. This opens the one
    // exception, READ_CONFIG on a machine with no image at all, which is CI.
    // It must never be set on the cluster: the point of the container is that
    // the versions are the ones that were built, not the ones the host happens
    // to have.
    allow_host_python = false

    // The most GPU jobs this run may have in flight at once, and therefore how
    // much of jic-gpu it holds. Applied as `maxForks` on the gpu label below.
    //
    // Nothing here uses SLURM job arrays. Nextflow's grid executor submits one
    // independent sbatch per task unless the `array` directive is set, and it
    // is not set anywhere in this repo. So MaxArraySize is irrelevant; the
    // limits that could bite are the association's MaxJobs=200 and
    // MaxSubmit=3000, both far above anything here.
    //
    // 26 is every A100 on the partition. Lower it on a busy weekday:
    //   nextflow run ... --max_gpu_jobs 16
    max_gpu_jobs = 26
}

process {
    errorStrategy = 'terminate'

    // Config reading is a stdlib Python call. It needs no scheduler.
    withLabel: tiny {
        executor = 'local'
        cpus     = 1
        memory   = '1 GB'
    }

    // 8 GB rather than the measured 5.1 GB peak. That peak is per whole job,
    // so it bounds every stage without saying which one reached it. Until
    // there is a per-stage measurement, both labels carry the same headroom.
    withLabel: cpu {
        executor = 'slurm'
        queue    = 'jic-short'
        cpus     = 2
        memory   = '8 GB'
        time     = '1h'
    }

    withLabel: gpu {
        executor      = 'slurm'
        queue         = 'jic-gpu'
        cpus          = 4
        memory        = '8 GB'
        time          = '2h'
        clusterOptions = '--gres=gpu:1'

        // One task holds one A100, so this IS the GPU concurrency. It is a
        // per-label bound rather than executor.queueSize, because queueSize is
        // shared with the cpu-labelled stages and a 90-target sweep has plenty
        // of those. Without it, collect and postprocess tasks take slots that
        // Boltz should be using.
        //
        // 26 is every A100 on jic-gpu. See the executor block below for why
        // that is the number and what it costs other people.
        maxForks      = params.max_gpu_jobs

        // A prediction that dies on a transient node problem is worth one
        // retry. One that is genuinely broken is then ignored, so the other
        // designs still finish, which is what the shell orchestrator did.
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
        maxRetries    = 1
    }
}

// jic-gpu has 26 A100s across 10 nodes, not 10 GPUs. The nodes are not uniform:
// j1024n2-n3 carry 1 each, n4-n7 carry 2, n8-n11 carry 4. `sinfo -p jic-gpu -N
// -o "%N %G"` is the check.
//
// The old value of 10 came from notes/repo-cleanup-playbook.md, which records
// "the genuine ceiling was 10 A100s cluster-wide". That is the NODE count. It
// left more than half the partition idle. Nothing in Slurm was enforcing it
// either: the jic-gpu QOS sets no GrpTRES, MaxTRESPU, MaxJobsPU or MaxSubmitPU,
// and the account association allows MaxJobs=200 and MaxSubmit=3000.
//
// queueSize is every SLURM task in flight, cpu and gpu together, so it is set
// above the GPU bound to leave room for the short cpu stages. The GPU bound
// itself is maxForks on the gpu label.
//
// maxForks = 26 takes the whole partition when it is free. That is a choice
// about sharing, not a technical limit, and it is worth revisiting on a busy
// weekday. Lower it to leave headroom:
//
//   nextflow run ... --max_gpu_jobs 16      (see params.max_gpu_jobs above)
executor {
    name      = 'slurm'
    queueSize = 40
}

// ---------------------------------------------------------------------------
// Profiles, and the version trap underneath them
// ---------------------------------------------------------------------------
// Nextflow 25.10.x REPLACES a `withLabel:` block when a profile defines the
// same selector. It does not merge it into the one above. 26.04 merges. The
// cluster runs 25.10.4, and the profile here used to be
//
//     hpc { process { withLabel: gpu { executor = 'slurm' } } }
//
// which reduced the gpu label to exactly that one line. No queue, no
// --gres=gpu:1, no cpus, no memory, no walltime. Nextflow then submitted a bare
// sbatch, SLURM put the job on whatever partition it liked with 1 CPU and no
// GPU, and Boltz died with "No supported gpu backend found!". A laptop check on
// 26.04 could not see any of this, because there the same config merges.
//
// So: no profile may redefine a selector the `process` block above defines,
// unless it redefines it completely. `hpc` sets a different key entirely, and
// `local` is complete in itself. tests/test_nextflow_profiles.py holds the line,
// and CI resolves the config on the cluster's own Nextflow version.
//
// There is deliberately no profile named `standard`. Nextflow applies that one
// whenever -profile is omitted, so having it meant a bare `nextflow run` on the
// cluster silently took the laptop settings.

profiles {

    // Laptop and CI: run everything locally, for a check of the DAG shape. The
    // GPU stages will fail without a container; use -stub-run for a dry
    // structural run.
    //
    // Complete in itself, so it behaves the same whether the Nextflow in use
    // replaces the blocks above or merges into them. The local executor
    // enforces cpus and memory against the machine, so a 2-core CI runner would
    // refuse to start a task asking for the 8 GB a real prepare stage needs,
    // and a structural check would fail for a reason that has nothing to do
    // with the DAG.
    local {
        process {
            withLabel: tiny {
                executor = 'local'
                cpus     = 1
                memory   = '512 MB'
                clusterOptions = ''
            }
            withLabel: cpu {
                executor = 'local'
                cpus     = 1
                memory   = '512 MB'
                time     = null
                queue    = null
                clusterOptions = ''
            }
            withLabel: gpu {
                executor = 'local'
                cpus     = 1
                memory   = '512 MB'
                time     = null
                queue    = null
                clusterOptions = ''
            }
        }
    }

    // The cluster. This is the `process` block above, unchanged, which is the
    // whole point: it sets `process.executor`, a different key from
    // `withLabel:cpu`, so nothing above it is replaced on any version.
    hpc {
        process.executor = 'slurm'
    }
}

// Run artefacts go in one hidden directory rather than four files in the repo
// root. Nextflow writes trace, report and timeline wherever it is told; its own
// .nextflow.log is decided before this file is read, so that one needs
// NXF_LOG_FILE or `nextflow -log`. See the README.
//
//   nextflow -log .nextflow-reports/nextflow.log run main.nf --targets ...
//
// The trace is what the compute-cost analysis reads. standalone_elapsed_s in
// that analysis is derived from it, so keep the columns it expects.
trace {
    enabled   = true
    overwrite = true
    file      = '.nextflow-reports/trace.txt'
    fields    = 'task_id,hash,name,status,exit,submit,duration,realtime,%cpu,peak_rss,workdir'
}

report   { enabled = true; overwrite = true; file = '.nextflow-reports/report.html' }
timeline { enabled = true; overwrite = true; file = '.nextflow-reports/timeline.html' }

// The completion summary lives here rather than in main.nf: the strict parser
// introduced in Nextflow 26 rejects statements at script level.
workflow.onComplete = {
    println "negative steering ${workflow.success ? 'complete' : 'FAILED'} in ${workflow.duration}"
}
