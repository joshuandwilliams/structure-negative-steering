# ============================================================
# .gitignore for structure-negative-steering
# ============================================================

# ----- Experiments — results are HPC-only; test DEFINITIONS are tracked -----
# The experiments/ tree (prior runs migrated from the HPC scratch folder plus
# future run outputs) is local/HPC-only. EXCEPTIONS that ARE tracked:
#   - experiments/README.md
#   - experiments/benchmarking/  test specs: config.yml + reference *.pdb + READMEs
# Derived inputs/ and run/ outputs stay ignored even under benchmarking/.
experiments/*
!experiments/README.md
!experiments/benchmarking/
experiments/benchmarking/*
!experiments/benchmarking/README.md
!experiments/benchmarking/*/
experiments/benchmarking/*/*
!experiments/benchmarking/*/config.yml
!experiments/benchmarking/*/*.pdb
!experiments/benchmarking/*/README.md

# ----- Nextflow -----
.nextflow/
.nextflow.log*
.nextflow.history*
work/

# ----- Pipeline-style outputs -----
*_results/
results/

# ----- SLURM logs -----
*.out
*.err
slurm-*.out
slurm-*.err

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Microsoft Office lock files -----
~$*

# ----- Editors / IDEs -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Environment / secrets -----
.env
.env.local
*.local

# ----- Build / packaging -----
build/
dist/
*.egg
.eggs/

# ----- Singularity / Apptainer images -----
*.img
*.sif

# ----- Sync helper artefacts -----
rsync_dryrun*.txt
rsync_deletions*.txt

# ----- OS / misc -----
Thumbs.db
desktop.ini
