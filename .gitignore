# ============================================================
# .gitignore for structure-negative-steering
# ============================================================

# ----- Nextflow -----
.nextflow/
.nextflow.log*
.nextflow.history*
.nextflow-reports/
work/
nxf_home/

# ----- Pipeline-style outputs -----
*_results/
results/

# ----- SLURM logs -----
*.out
*.err
slurm-*.out
slurm-*.err

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ----- Jupyter -----
.ipynb_checkpoints/

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- Microsoft Office lock files -----
~$*

# ----- Editors / IDEs / agents -----
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# ----- Environment / secrets -----
.env
.env.local
*.local

# ----- Workflow-check outputs. Same rule: the config is tracked, the run is not -----
tests/test_run/run/
tests/test_run/run_cli/
tests/test_run/inputs/
tests/test_run/*.out
tests/test_run/*.err

# ----- Coverage artefacts, regenerated by any test run -----
htmlcov/
lcov.info
.coverage
# Written by the --cov-report=xml the Tests workflow passes, and uploaded to
# Codecov from there rather than committed.
coverage.xml

# ----- Build / packaging -----
build/
dist/
*.egg
.eggs/

# ----- Singularity / Apptainer images -----
*.img
*.sif

# ----- Nextflow run reports, regenerated on every run -----
trace.txt
report.html
timeline.html

# ----- Archive: superseded code kept for the record, not run -----
# archive/prerepo_scripts/ holds the pre-repo sequence-walk and seed-variance
# diagnostics. Nothing imports them and they are excluded from ruff. Kept
# because eight of them have no descendant anywhere in this repo's history.
archive/

# The testing image's def is local-only, and containers/Dockerfile.test
# supersedes it. See containers/README.md for the one case it still covers,
# which is measuring the engine's own coverage from inside the runtime image.
containers/boltz2_negsteer_testing.def

# ----- Site settings: partitions, container paths, an ssh host -----
# site.conf.example is tracked and documents every setting. The real file is
# one person's cluster and belongs to them, not to the repo.
site.conf

# ----- Working notes, local only -----
notes/repo-cleanup-playbook.md
notes/*.html
docs/development_notes/

# ----- OS / misc -----
Thumbs.db
desktop.ini

# Scratch frame from docs/make_logo.py, removed on a clean run.
docs/.logo_tmp.png
